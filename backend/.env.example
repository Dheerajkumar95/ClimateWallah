# ClimateWallah backend environment
# Copy to backend/.env and replace every CHANGE_ME value.

# Application
FRONTEND_URL=https://climatewallah.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://climatewallah.com,https://www.climatewallah.com
UPLOAD_MAX_SIZE_MB=15

# MongoDB (keep MongoDB bound to localhost on a single VPS)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=climatewallah

# Authentication
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_64
JWT_EXPIRE_MINUTES=480
# auto = true for HTTPS FRONTEND_URL, false for local HTTP. You may explicitly set true/false.
COOKIE_SECURE=auto

# Initial admin (used when the admin collection is first seeded)
ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=admin@climatewallah.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# GoDaddy Professional Email / Titan
EMAIL_ENABLED=true
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=noreply@climatewallah.com
SMTP_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
SMTP_FROM_EMAIL=noreply@climatewallah.com
SMTP_FROM_NAME=Climate Wallah
SMTP_REPLY_TO=support@climatewallah.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=20
ENQUIRY_NOTIFY_EMAIL=support@climatewallah.com

# Payments
# Production payment credentials can be configured from Admin. Environment values are fallback only.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_PAYMENT_WEBHOOK_SECRET=CHANGE_ME
RAZORPAYX_ACCOUNT_NUMBER=CHANGE_ME
RAZORPAYX_WEBHOOK_SECRET=CHANGE_ME

# Dedicated Fernet key for encrypted reviewer bank/UPI details.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
