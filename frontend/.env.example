# Local development
# Prefer leaving REACT_APP_BACKEND_URL blank: the app automatically uses the same hostname
# as the browser (localhost -> localhost:8000, 127.0.0.1 -> 127.0.0.1:8000).
REACT_APP_BACKEND_URL=

# Production (same domain through Nginx): leave blank so window.location.origin is used.
# For a separate API domain you may set, for example:
# REACT_APP_BACKEND_URL=https://api.climatewallah.com
